# Eye Compass backend configuration.
# Copy to .env and adjust. Anything exported in the environment (e.g. the
# Environment= lines in the systemd unit) wins over this file.

# ---- Runtime mode -------------------------------------------------------
# true  -> synthetic frames, no hardware, no TensorRT imports (dev machines)
# false -> real Hikrobot SDK + TensorRT engines (the Jetson)
USE_MOCK_CAMERA=true

# ---- Database -----------------------------------------------------------
# Matches the db service in ../docker-compose.yml (network_mode: host, port 5432).
DATABASE_URL=postgresql://postgres:password@localhost:5432/eye_compass

# ---- Paths --------------------------------------------------------------
# The legacy tree, which still provides run_inference.py and the model files.
EYE_COMPASS_SRC=/home/nvidia/eye_compass
MODEL_DIR=/home/nvidia/eye_compass/models
MVS_SDK_PATH=/home/nvidia/MVS/Samples/aarch64/Python/MvImport
CAMERA_FEATURE_FILE=/home/nvidia/eye_compass/FeatureFile_new.ini
CONFIG_INI_PATH=/home/nvidia/eye_compass/config.INI
# Where scan crops and frames are written, and what the S3 worker uploads.
OUTPUT_DIR=/home/nvidia/eye_compass_new/eye_compass_be

# ---- Camera -------------------------------------------------------------
# Defaults match the legacy hardcoded values (GrabImage.py:677-678). The
# [CAMERA] runtime_* keys in config.INI are not read by any legacy code path.
# CAMERA_INDEX=0
# CAMERA_EXPOSURE_TIME=600.0
# CAMERA_GAIN=0.0
# CAMERA_FRAME_DECIMATION=2

# ---- Streaming ----------------------------------------------------------
STREAM_FPS=20
STREAM_JPEG_QUALITY=70
# STREAM_MAX_WIDTH=1280

# ---- Sessions -----------------------------------------------------------
# There is deliberately no session-lifetime setting. A login lasts until
# Keycloak says the account is no longer good; time alone never ends one, so a
# device that is offline for months keeps working.
#
# Re-check each online session against Keycloak: record that it is still fine,
# or (if the account was disabled, or the operator signed in offline and
# connectivity has since returned) flag it so they are asked to sign in again
# the next time they reach the Home screen — never mid-batch. A device that
# simply cannot reach Keycloak is left completely alone.
#
# Each session is checked ONCE A DAY. The interval below is only how often the
# worker wakes up and looks: a session already confirmed today is skipped
# without contacting Keycloak, so waking every 6 hours costs nothing extra but
# gives a device that was offline at the first attempt three more chances
# before tomorrow. A successful sync also triggers a look, since it proves the
# network is up — same once-a-day rule applies, so it is free when the check
# has already been done.
SESSION_REVALIDATION_ENABLED=true
SESSION_REVALIDATION_INTERVAL_HOURS=6

# Login screen presentation only. "single_form" is the current form. Future:
# "redirect" (Keycloak's hosted page online, our form offline) / "combined".
LOGIN_UI_MODE=single_form

# ---- S3 (AWS Cognito identity pool) -------------------------------------
S3_ENABLED=true
AWS_REGION=us-east-2
AWS_S3_BUCKET=agnext-cognito
AWS_IDENTITY_POOL_ID=CHANGE_ME
S3_BUCKET_FOLDER=auto-bucket-cgi-prod
# S3_UPLOAD_INTERVAL_SECONDS=60

# ---- Google Sheets ------------------------------------------------------
SHEETS_ENABLED=false
# Absolute path, or a filename resolved against the backend root then EYE_COMPASS_SRC.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Background workers -------------------------------------------------
SYNC_WORKER_ENABLED=true
SYNC_RETRY_INTERVAL_MINUTES=30


# ==========================================================================
# ENVIRONMENT — switch between dev / qa / prod
# ==========================================================================
# Everything in this section points the backend at a different Qualix
# environment. Two more variables have to move together with these but live
# down in the AUTH PROVIDER section below, because they only apply under
# AUTH_PROVIDER=keycloak: KEYCLOAK_URL and ASSURANCE_API_URL. Pointing one
# group at prod and the other at dev/qa silently changes where scan data
# lands the moment AUTH_PROVIDER is flipped — keep all of them in step.

# QUALIX_RUN_ENV selects which config.INI [API_ENV] URL QUALIX_API_URL falls
# back to (dev/qa/prod) when QUALIX_API_URL itself isn't set below.
# QUALIX_RUN_ENV=prod
QUALIX_API_URL=https://assaying.qualix.ai/

# Legacy always writes to one hardcoded sheet regardless of environment; this
# at least makes it explicitly configurable. Direct and simple: whatever ID
# is written here is what's used, no environment-based selection.
SHEETS_SPREADSHEET_ID=


# ==========================================================================
# AUTH PROVIDER — switch between "keycloak" and "legacy"
# ==========================================================================
# AUTH_PROVIDER selects where operator login is verified:
#   legacy   = Qualix directly (today's behavior, unchanged)
#   keycloak = this org's Keycloak, which already fronts Qualix via Assurance
# Offline login (cached password hash) and the device-credential fallback
# behave identically either way. Everything else in this section is only
# read when AUTH_PROVIDER=keycloak.
AUTH_PROVIDER=legacy

# KEYCLOAK_URL and ASSURANCE_API_URL both have dev/prod alternates — these are
# the ENVIRONMENT-switch variables that live here instead of in the
# ENVIRONMENT section above, since they only mean anything under
# AUTH_PROVIDER=keycloak. Keep them pointed at the same environment as
# QUALIX_API_URL above, or scan data silently lands somewhere unexpected.
KEYCLOAK_URL=https://dev.perfeqtfoods.com/keycloak
KEYCLOAK_REALM=CentralIAM
# Reusing Qualix's own backend client — a dedicated client would also need an
# Assurance-side change. Direct Access Grants (ROPC) is already enabled on it.
KEYCLOAK_CLIENT_ID=qualix-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
# Scopes requested at login — must match what is attached to KEYCLOAK_CLIENT_ID
# in Keycloak exactly, or the whole login fails with invalid_scope.
#   offline_access                  long-lived login (realm caps a normal
#                                    refresh token at SSO Session Max = 1 day)
#   qualix-application-permissions  the `permissions` claim Qualix checks
#   audience-for-gateway            puts gateway-client in the token audience
#   add-asu-be-audience             puts asu-be in the token audience
# The last two are required or the Assurance gateway rejects every request
# with "Client is not within the token audience".
KEYCLOAK_SCOPE=offline_access qualix-application-permissions audience-for-gateway add-asu-be-audience

# Assurance gateway. It fronts the same Qualix endpoints WITHOUT the "portal/"
# prefix direct Qualix uses — see ASSURANCE_CONFIG_URI / ASSURANCE_ANALYSIS_POST_URI
# below. Required when AUTH_PROVIDER=keycloak.
ASSURANCE_API_URL=
# ASSURANCE_CONFIG_URI=api/icompass/v1/config
# ASSURANCE_ANALYSIS_POST_URI=api/scan/v2/post-visio
# Called right after every Keycloak login with the operator's own access
# token — the same call Qualix's own web login makes to look up the account.
# This is what actually confirms someone is a Qualix operator: Keycloak alone
# only proves the password is valid on the shared realm, not that the person
# has any business using this device. A login Keycloak accepts but this
# check rejects (HTTP 500, body message "USERNR01") is refused outright.
# ASSURANCE_KEYCLOAK_PROFILE_URI=api/user/keycloak-profile

# ---- Two accounts, two jobs. Do NOT set them to the same thing. ---------
#
# WHO SYNCS. The fixed account every outbound delivery authenticates as — the
# scan POST and the config fetch, under BOTH auth providers, never the
# logged-in operator (someone who signed in offline has no token at all).
# Under AUTH_PROVIDER=keycloak it must be a real KEYCLOAK account.
# No fallback: blank means syncing fails loudly and says what to set.
SYNC_SERVICE_USERNAME=
SYNC_SERVICE_PASSWORD=

# WHO CAN GET IN WHEN NOTHING ELSE WORKS (tier 3 / emergency). Unlocks the
# device when Keycloak is unreachable AND no cached password exists — a new
# device, or one this operator has never logged into online here. Checked
# entirely on-device; no network call, and it authenticates nothing outbound.
#
# A door key, not an identity — give it its own credentials rather than
# reusing a real operator's, or anyone who needs emergency access to the
# device also holds the account that posts every scan. Need not exist in
# Keycloak or in Qualix.
EMERGENCY_LOGIN_USERNAME=
EMERGENCY_LOGIN_PASSWORD=

# QUALIX_USERNAME / QUALIX_PASSWORD no longer exist as settings. The old
# names are still accepted as deprecated aliases for EMERGENCY_LOGIN_* above
# (as is legacy config.INI's CONFIG_SETTINGS), so a device already in the
# field keeps its recovery login on upgrade. The backend warns at startup
# while either is still supplying it.
# QUALIX_USERNAME=
# QUALIX_PASSWORD=


# ==========================================================================
# NEW DEVICE SETUP — must be set/verified per physical device
# ==========================================================================
# Everything below needs a fresh look on every new device. Some values MUST
# be unique per device (DEVICE_ID, DEVICE_CODE, WAREHOUSE_NAME); others are
# the same on most devices but still need verifying because auto-detection
# or environment differences can silently break them (the serial port, CORS).

# Fixed 2 characters (A-Z / 0-9), UNIQUE PER PHYSICAL DEVICE. Prefixed to
# every batch number; the remaining 10 digits are an epoch timestamp, which
# two devices can produce identically, so this code is the only thing keeping
# their batch numbers apart. Batch creation errors out until it is set.
# Unrelated to DEVICE_CODE below (that one is the device_serial_no sent to
# Qualix on the scan datagram) — neither is derived from the other.
DEVICE_ID=

# Sent as device_serial_no on every scan datagram, alongside operator_id and
# WAREHOUSE_NAME below — this trio is what lets Qualix map location explicitly
# from the payload instead of inferring it from whichever account
# authenticated the sync post. Fixed per physical device.
DEVICE_CODE=ABCNUMBER

# Paired with DEVICE_CODE above — sent as warehouse_name on every scan datagram.
WAREHOUSE_NAME=

# Leave unset to auto-detect (/dev/ttyUSB0, then ttyACM*, then ttyTHS*). Same
# value on most Jetsons (the onboard UART), but still worth confirming on
# every new device rather than trusting auto-detect: once some other
# USB-serial device is plugged in and claims /dev/ttyUSB0 first, auto-detect
# silently picks that one instead of the conveyor controller.
# EYE_COMPASS_SERIAL_PORT=/dev/ttyUSB0
# EYE_COMPASS_SERIAL_BAUD=9600
# SERIAL_MAX_RETRIES=3

# Explicit rather than "*", because this service drives physical hardware.
CORS_ORIGINS=http://localhost:5143,http://localhost:5173,http://127.0.0.1:5143,http://127.0.0.1:5173
